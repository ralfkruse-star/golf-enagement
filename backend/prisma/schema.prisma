// Golf Engagement System - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MEMBERS & AUTH
// ============================================================================

enum MembershipType {
  FULL
  JUNIOR
  SENIOR
  GUEST
  HONORARY
  TRIAL
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
  GUEST
}

model Member {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // bcrypt hashed
  firstName String
  lastName  String

  // Membership
  membershipType   MembershipType
  membershipStatus MembershipStatus @default(PENDING)
  membershipNumber String?          @unique
  role             UserRole         @default(MEMBER)

  // Golf Data
  handicap  Float?
  birthDate DateTime?
  gender    String?   // M, F, O

  // Contact
  phone     String?
  address   String?
  city      String?
  zipCode   String?

  // Metadata
  joinDate      DateTime  @default(now())
  lastLoginAt   DateTime?
  emailVerified Boolean   @default(false)

  // Preferences
  notificationPreferences Json? // { push: true, email: true, sms: false, ... }
  language                String @default("de")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete for GDPR

  // Relations
  segments            MemberSegmentAssignment[]
  eventRegistrations  EventRegistration[]
  feedPosts           FeedPost[]
  feedComments        FeedComment[]
  feedLikes           FeedLike[]
  pushTokens          PushToken[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  achievements        MemberAchievement[]
  teeTimeBookings     TeeTimeBooking[]
  payments            Payment[]
  subscriptions       Subscription[]
  handicapHistory     HandicapHistory[]
  rounds              Round[]

  @@index([email])
  @@index([membershipType, membershipStatus])
  @@index([lastName, firstName])
  @@map("members")
}

// ============================================================================
// SEGMENTATION
// ============================================================================

model Segment {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  // Criteria (JSON)
  // Example: { membershipType: ["FULL", "SENIOR"], ageRange: [50, 100], handicapRange: [0, 20] }
  criteria Json

  // Metadata
  isSystem    Boolean @default(false) // Built-in segments like "all-members"
  memberCount Int     @default(0)     // Cached count

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members          MemberSegmentAssignment[]
  targetedEvents   Event[]                   @relation("EventTargetSegments")
  targetedPosts    FeedPost[]                @relation("FeedPostTargetSegments")
  notifications    Notification[]            @relation("NotificationTargetSegments")

  @@map("segments")
}

model MemberSegmentAssignment {
  memberId  String
  segmentId String

  assignedAt DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([memberId, segmentId])
  @@map("member_segment_assignments")
}

// ============================================================================
// EVENTS
// ============================================================================

enum EventType {
  TOURNAMENT
  TRAINING
  SOCIAL
  MEETING
  COURSE_MAINTENANCE
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String?
  type        EventType
  status      EventStatus @default(DRAFT)

  // Date & Time
  startDate DateTime
  endDate   DateTime?

  // Location
  location String?

  // Capacity
  maxParticipants     Int?
  currentParticipants Int      @default(0)
  waitlistEnabled     Boolean  @default(true)

  // Registration
  registrationDeadline DateTime?
  requiresApproval     Boolean   @default(false)

  // Visibility
  isPublic Boolean @default(true)

  // Media
  imageUrl    String?
  attachments Json? // Array of URLs

  // Targeting
  targetSegmentIds String[] // Array of segment IDs

  // Metadata
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  targetSegments Segment[]           @relation("EventTargetSegments", references: [id])
  registrations  EventRegistration[]

  @@index([startDate])
  @@index([type, status])
  @@map("events")
}

enum RegistrationStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
  REJECTED
}

model EventRegistration {
  id String @id @default(uuid())

  eventId  String
  memberId String

  status       RegistrationStatus @default(CONFIRMED)
  waitlistPos  Int?               // Position on waitlist
  comment      String?            // Optional message from member
  approvedBy   String?            // Admin who approved (if requiresApproval)
  approvedAt   DateTime?
  cancelledAt  DateTime?

  registeredAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([eventId, status])
  @@map("event_registrations")
}

// ============================================================================
// SOCIAL FEED
// ============================================================================

enum FeedPostType {
  ANNOUNCEMENT
  EVENT
  ACHIEVEMENT
  GENERAL
  PHOTO
  VIDEO
}

model FeedPost {
  id      String       @id @default(uuid())
  content String
  type    FeedPostType @default(GENERAL)

  // Media
  mediaUrls Json? // Array of image/video URLs

  // Visibility
  isPinned    Boolean @default(false)
  isPublished Boolean @default(true)

  // Targeting
  targetSegmentIds String[] // Empty = all members

  // Engagement
  likeCount    Int @default(0)
  commentCount Int @default(0)
  viewCount    Int @default(0)

  // Author
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  author         Member        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  targetSegments Segment[]     @relation("FeedPostTargetSegments", references: [id])
  comments       FeedComment[]
  likes          FeedLike[]

  @@index([createdAt])
  @@index([isPinned, isPublished])
  @@map("feed_posts")
}

model FeedComment {
  id      String @id @default(uuid())
  content String

  postId   String
  authorId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author Member   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("feed_comments")
}

model FeedLike {
  postId   String
  memberId String

  createdAt DateTime @default(now())

  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  member Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([postId, memberId])
  @@map("feed_likes")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  PUSH
  EMAIL
  SMS
  IN_APP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model Notification {
  id    String           @id @default(uuid())
  title String
  body  String
  type  NotificationType @default(PUSH)

  // Delivery
  priority   NotificationPriority @default(NORMAL)
  status     NotificationStatus   @default(DRAFT)

  // Targeting
  recipientSegmentIds String[] // Segment IDs
  recipientIds        String[] // Specific member IDs (optional, overrides segments)

  // Scheduling
  scheduledAt DateTime?
  sentAt      DateTime?
  expiresAt   DateTime?

  // Payload
  data Json? // Custom data (e.g., deeplink, action buttons)

  // Media
  imageUrl String?

  // Delivery Stats
  totalRecipients Int @default(0)
  successCount    Int @default(0)
  failureCount    Int @default(0)

  // Metadata
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  targetSegments Segment[] @relation("NotificationTargetSegments", references: [id])

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("notifications")
}

model PushToken {
  id    String @id @default(uuid())
  token String @unique

  memberId String

  platform String // ios, android, web

  isActive  Boolean   @default(true)
  lastUsed  DateTime  @default(now())
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, isActive])
  @@map("push_tokens")
}

// ============================================================================
// GAMIFICATION
// ============================================================================

enum AchievementType {
  ATTENDANCE
  PARTICIPATION
  SCORE
  MILESTONE
  SOCIAL
  OTHER
}

model Achievement {
  id          String          @id @default(uuid())
  name        String          @unique
  description String
  type        AchievementType

  iconUrl String?
  points  Int     @default(0) // Points awarded

  // Criteria (JSON)
  criteria Json

  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  members MemberAchievement[]

  @@map("achievements")
}

model MemberAchievement {
  memberId      String
  achievementId String

  earnedAt DateTime @default(now())

  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([memberId, achievementId])
  @@index([memberId, earnedAt])
  @@map("member_achievements")
}

// ============================================================================
// AUDIT & LOGGING
// ============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  OTHER
}

model AuditLog {
  id String @id @default(uuid())

  memberId String?
  action   AuditAction
  resource String // "member", "event", etc.

  resourceId String?
  changes    Json? // Before/after snapshot

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ============================================================================
// MEDIA
// ============================================================================

model Media {
  id       String @id @default(uuid())
  filename String
  mimeType String
  size     Int // bytes

  url         String
  thumbnailUrl String?

  uploadedBy String?

  createdAt DateTime @default(now())

  @@map("media")
}

// ============================================================================
// SYSTEM SETTINGS
// ============================================================================

model Setting {
  key   String @id
  value Json

  description String?

  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================================================
// TEE-TIME BOOKING SYSTEM
// ============================================================================

enum TeeTimeStatus {
  AVAILABLE
  PARTIAL
  FULL
  BLOCKED
  COMPLETED
}

model TeeTimeSlot {
  id   String @id @default(uuid())
  date DateTime
  time String // "08:00", "08:10", etc.

  maxPlayers     Int @default(4)
  currentPlayers Int @default(0)

  status      TeeTimeStatus @default(AVAILABLE)
  isBlocked   Boolean       @default(false)
  blockReason String?

  course String @default("main")
  holes  Int    @default(18)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings TeeTimeBooking[]

  @@unique([date, time, course])
  @@index([date, status])
  @@map("tee_time_slots")
}

enum BookingStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
  NO_SHOW
  COMPLETED
}

model TeeTimeBooking {
  id String @id @default(uuid())

  slotId   String
  memberId String

  players   Int      @default(1)
  playerIds String[]

  status BookingStatus @default(CONFIRMED)

  bookedAt    DateTime  @default(now())
  cancelledAt DateTime?

  isRecurring      Boolean @default(false)
  recurringPattern Json?

  notes String?

  slot   TeeTimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  member Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([slotId, status])
  @@index([memberId, bookedAt])
  @@map("tee_time_bookings")
}

model TeeTimeConfiguration {
  id String @id @default(uuid())

  startTime String @default("07:00")
  endTime   String @default("20:00")
  interval  Int    @default(10)

  advanceBookingDays        Json @default("{\"FULL\":7,\"GUEST\":3}")
  cancellationDeadlineHours Int  @default(24)
  noShowPenaltyDays         Int  @default(7)

  isActive Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("tee_time_configuration")
}

// ============================================================================
// PAYMENT SYSTEM
// ============================================================================

enum PaymentType {
  EVENT_FEE
  MEMBERSHIP
  MERCHANDISE
  SERVICE
  TEE_TIME
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id String @id @default(uuid())

  memberId String
  amount   Int
  currency String @default("EUR")

  type   PaymentType
  status PaymentStatus @default(PENDING)

  eventId        String?
  teeTimeSlotId  String?
  subscriptionId String?

  stripePaymentIntentId   String? @unique
  stripeCheckoutSessionId String? @unique

  description String?
  receiptUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt    DateTime?

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, status])
  @@map("payments")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

model Subscription {
  id String @id @default(uuid())

  memberId String
  planId   String

  stripeSubscriptionId String @unique
  stripeCustomerId     String

  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member           @relation(fields: [memberId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([memberId, status])
  @@map("subscriptions")
}

model SubscriptionPlan {
  id   String @id @default(uuid())
  name String @unique

  description String?

  amount   Int
  currency String @default("EUR")
  interval String @default("year")

  stripePriceId String @unique

  isActive Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

// ============================================================================
// HANDICAP SYSTEM
// ============================================================================

model HandicapHistory {
  id String @id @default(uuid())

  memberId String

  handicap Float
  date     DateTime @default(now())

  roundId String?
  reason  String? // "tournament", "casual_round", "adjustment"

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@map("handicap_history")
}

model Round {
  id String @id @default(uuid())

  memberId  String
  courseId  String  @default("main")
  date      DateTime
  strokes   Int
  coursePar Int     @default(72)

  courseRating Float @default(72.0)
  slopeRating  Int   @default(113)

  handicapBefore Float
  handicapAfter  Float?

  verified Boolean @default(false)

  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, date])
  @@map("rounds")
}
